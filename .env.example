# --- Supabase (content + CMS) ----------------------------------------
# Project settings -> Data API. The publishable key is safe in the client;
# row level security is what protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Lead capture ------------------------------------------------------
# Apps Script Web App URL that records leads into Google Sheets.
# See docs/google-sheets-setup.md. Without this, submitted leads are LOST.
VITE_ENQUIRY_ENDPOINT=
