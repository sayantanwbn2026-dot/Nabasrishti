# --- Supabase (content + CMS) ----------------------------------------
# Project settings -> Data API. The publishable key is safe in the client;
# row level security is what protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Lead capture ------------------------------------------------------
# Apps Script Web App URL that mirrors leads into Google Sheets, for the
# marketing team. See docs/google-sheets-setup.md.
#
# Optional for the lead itself: every enquiry is written to the CMS first,
# so leaving this blank costs the spreadsheet copy and the Ads campaign
# reporting that goes with it, not the lead. With neither this nor Supabase
# configured, the form refuses to submit rather than showing a thank-you it
# cannot honour.
VITE_ENQUIRY_ENDPOINT=
